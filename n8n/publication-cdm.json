    {
      "id": "409b2598-d850-4c45-a6c6-bda5a6e7ad0d",
      "parameters": {
        "jsCode": "// Protection contre la double publication : si une exécution est relancée,\n// on ne republie pas un post dont la légende figure déjà parmi les derniers posts.\nconst post = $('Post du jour').first().json;\nconst debut = s => (s || '').replace(/\\s+/g, ' ').trim().slice(0, 80);\nconst recents = ($input.first().json.data || []).map(m => debut(m.caption));\nconst deja = recents.includes(debut(post.legende));\nreturn [{ json: { ...post, deja_publie: deja } }];",
        "url": ""
      },
      "name": "Deja publie ?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        0
      ]
    },
