    {
      "id": "16fe2df6-6079-420c-864e-edd0c7e87a30",
      "parameters": {
        "jsCode": "// Parametres du compte CDM Conciergerie. Seul endroit a modifier.\nreturn [{ json: {\n  // Connexion Instagram, comme le compte DelorIA (token de 60 jours renouvele chaque mois).\n  API_BASE: 'https://graph.instagram.com',\n  // Identifiant du compte Instagram professionnel de CDM.\n  IG_ID: '17841476967149235',\n  CALENDRIER_URL: 'https://raw.githubusercontent.com/tomhodet/cdm-insta/main/calendrier/calendrier.json',\n  // Texte alternatif (1000 caracteres max) sur l'image seule et chaque element de carrousel.\n  ALT_TEXT: true,\n  // Lieu Facebook. Si non vide, envoye en location_id sur le conteneur image simple ou CAROUSEL.\n  LOCATION_ID: ''\n} }];",
        "url": ""
      },
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        100
      ]
    },
    {
      "id": "97432175-70b3-4354-8690-7c7368fda06f",
      "parameters": {
        "url": "={{ $('Config').first().json.CALENDRIER_URL }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "name": "Lire calendrier",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        100
      ]
    },
    {
      "id": "5a2cbcab-29a6-41bd-9bac-d5d058c26df9",
      "parameters": {
        "jsCode": "// Pour un test, mettre une date du calendrier, par exemple '2026-11-06'. Laisser vide en production.\nconst DATE_FORCEE = '';\n\nconst aujourdhui = DATE_FORCEE || $now.setZone('Europe/Paris').toISODate();\nconst posts = $input.all().map(i => i.json);\nconst post = posts.find(p => p.date === aujourdhui);\n\nif (!post) {\n  return [{ json: { trouve: false, date: aujourdhui } }];\n}\nreturn [{ json: { trouve: true, date: post.date, image_url: post.image_url,\n  images: post.images || [], carrousel: post.type === 'carrousel', legende: post.legende,\n  premier_commentaire: post.premier_commentaire || '', alt_text: post.alt_text || '' } }];",
        "url": ""
      },
      "name": "Post du jour",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        100
      ]
    },
